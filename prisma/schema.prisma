generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipType {
  individual
  corporate
}

enum SectorStatus {
  in_sector
  out_of_sector
}

enum CollectionType {
  entry_fee
  monthly_fee
  both
}

enum BusinessActivityType {
  manufacturer
  importer
  exporter
  seller
  service_other
}

enum ContactPreference {
  email
  sms
  phone
}

enum MaritalStatus {
  married
  single
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum Role {
  admin
  member
}

model Member {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- General info ---
  fullName              String
  companyName           String?
  title                 String?
  companyAddress        String?
  phone                 String?
  mobilePhone           String?
  email                 String                 @unique
  sectors               String[]               @default([])
  businessActivityTypes BusinessActivityType[] @default([])
  references            String?

  // --- Membership class (final classification is set by the board/admin) ---
  membershipType MembershipType?
  sectorStatus   SectorStatus?

  // --- Personal info ---
  birthPlace              String?
  birthDate               DateTime?
  nationality             String?
  nationalId              String?
  maritalStatus           MaritalStatus?
  faxPhone                String?
  personalMobilePhone     String?
  affiliatedOrganizations String?
  contactPreference       ContactPreference?
  locations               String[]           @default([])

  // --- Ödeme tercihi: ödeme entegrasyonu yok, dernek yönetimi bu verilerle
  // manuel çekim yapar. Kart bilgileri (varsa) tek bir alanda şifrelenmiş
  // olarak saklanır (bkz. common/crypto/encryption.service.ts).
  collectionType      CollectionType?
  // Giriş Aidatı (tek seferlik) için tam tarih; Aylık Aidat/Her İkisi
  // (tekrarlayan) için ayın günü — ikisi de opsiyonel, Tahsilat Türü'ne
  // göre hangisinin doldurulacağı frontend'de belirleniyor.
  autoDebitDate       DateTime?
  autoDebitDayOfMonth Int?
  cardDataEncrypted   String?
  paymentConsentAt    DateTime?

  // --- Application / approval workflow ---
  applicationDate   DateTime          @default(now())
  applicationStatus ApplicationStatus @default(pending)
  approvedAt        DateTime?
  isActive          Boolean           @default(true)

  // --- Consent captured at application time ---
  kvkkConsentAt           DateTime?
  bylawsAcknowledgedAt    DateTime?
  infoAccuracyConfirmedAt DateTime?

  // --- Documents uploaded with the application: Json array of {label, url} ---
  documents Json @default("[]")

  // --- Managed later by the member from their own panel ---
  logo                String?
  activityAreas       String[] @default([])
  productsAndServices String[] @default([])

  // --- Free-form label/value notes, Json object of string -> string ---
  notes Json?

  users User[]

  conversationsAsA Conversation[]  @relation("ConversationsAsA")
  conversationsAsB Conversation[]  @relation("ConversationsAsB")
  sentMessages     Message[]
  notifications    Notification[]
}

model News {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  summary     String?
  content     String?
  imageUrls   String[] @default([])
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
}

model Event {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  imageUrl    String?
}

model MembershipFee {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  label     String
  amount    Float
}

model OrganizationSettings {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String?
  shortName   String?
  logo        String?
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?

  // Json object of {facebook?, instagram?, linkedin?, twitter?}
  socialLinks Json?

  footerText        String?
  kvkkText          String?
  bylawsText        String?
  cookiePolicyText  String?
  privacyPolicyText String?

  showKvkkConsent            Boolean @default(true)
  requireKvkkConsent         Boolean @default(true)
  showBylawsConsent          Boolean @default(true)
  requireBylawsConsent       Boolean @default(true)
  showLoginMembershipCta     Boolean @default(true)
  showMembershipFeesTable    Boolean @default(true)
  showAttachmentsSection     Boolean @default(true)
  showMembershipClassSection Boolean @default(true)
}

model AboutPage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title          String?
  subtitle       String?
  bodyParagraph1 String?
  bodyParagraph2 String?
  visionText     String?
  missionText    String?
  image1         String?
  image2         String?
}

model PresidentMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image       String?
  messageHtml String?
}

enum BoardMemberCategory {
  yonetim_kurulu_asil
  yonetim_kurulu_yedek
  denetleme_kurulu_asil
  denetleme_kurulu_yedek
  disiplin_kurulu_asil
  disiplin_kurulu_yedek
}

model BoardMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  category BoardMemberCategory
  name     String
  title    String?
}

model DeviceToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token    String  @unique
  platform String?
}

// İki firma (Member) arasındaki tüm yazışma tek Conversation altında birikir;
// mesajlar ayrı kayıtlar olarak değil, bu conversation'a bağlı Message'lar
// halinde tutulur (bkz. ikinci-tur-plan.md Faz 4).
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberAId String
  memberBId String
  memberA   Member @relation("ConversationsAsA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB   Member @relation("ConversationsAsB", fields: [memberBId], references: [id], onDelete: Cascade)

  messages      Message[]
  notifications Notification[]

  @@unique([memberAId, memberBId])
}

model Message {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderMemberId String
  senderMember   Member @relation(fields: [senderMemberId], references: [id], onDelete: Cascade)

  body   String
  readAt DateTime?
}

enum NotificationType {
  new_message
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  recipientMemberId String
  recipientMember   Member @relation(fields: [recipientMemberId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  type   NotificationType
  title  String
  body   String
  isRead Boolean @default(false)
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String  @unique
  passwordHash String
  role         Role
  memberId     String?
  member       Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  isActive     Boolean @default(true)

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
}
