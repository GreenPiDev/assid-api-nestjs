# Bu dosya sadece örnektir; gerçek secret içermez.
# Local development için: `cp .env.example .env` yapıp kendi değerlerinle doldur.
# Production .env dosyası GitHub'a asla gönderilmez; VPS üzerinde ayrıca ve
# manuel olarak yönetilir (bkz. README > Deployment).

NODE_ENV=development
PORT=4000

# Local: docker-compose.yml içindeki postgres servisi (host portu 5434).
# Production: VPS'teki "postgres" container'ına Docker network üzerinden
# bağlanılır (host portu DEĞİL, container portu 5432 kullanılır):
#   postgresql://assid_user:PRODUCTION_PASSWORD@postgres:5432/assid_db?schema=public
DATABASE_URL=postgresql://assid:assid@localhost:5434/assid?schema=public

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Birden fazla origin izin vermek için virgülle ayır (boşluklar sorun değil)
# örn: https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP_USER / MAIL_FROM are auto-selected by NODE_ENV in MailService
# (developer@greenpiworks.com in dev, support@greenpiworks.com in prod).
# Only set them here to override that default.
SMTP_HOST=mail.greenpiworks.com
SMTP_PORT=587
SMTP_PASS=

FRONTEND_URL=http://localhost:5173

# Sadece bir kereye mahsus `npm run migrate:mongo` scripti için gerekliydi
# (eski Mongo verisini okumak için). Production'da gerekli değildir.
MONGODB_URI=mongodb://127.0.0.1:27017/your-db-name
