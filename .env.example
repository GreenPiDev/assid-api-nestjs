NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/your-db-name
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP_USER / MAIL_FROM are auto-selected by NODE_ENV in MailService
# (developer@greenpiworks.com in dev, support@greenpiworks.com in prod).
# Only set them here to override that default.
SMTP_HOST=mail.greenpiworks.com
SMTP_PORT=587
SMTP_PASS=
FRONTEND_URL=http://localhost:5173
